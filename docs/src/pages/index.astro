---
import SectionCards from "../components/SectionCards.astro";
import Layout from "../layouts/Layout.astro";
import { site } from "../site.config";
---

<Layout>
  <section class="hero">
    <h1 class="hero-title">{site.title}</h1>
    <p class="hero-subtitle">{site.description}</p>
    <div class="hero-actions">
      <a href="/guides/getting-started" class="zui-button">Get started</a>
      <a href="/reference/configuration" class="zui-button zui-button-variant-outline">Reference</a>
    </div>
    <p class="hero-note">
      Running in production on <a href="https://zander.wtf/search">zander.wtf/search</a> — see the
      <a href="/guides/examples">Examples guide</a> for its full source.
    </p>
  </section>

  <section class="landing-section flow">
    <h2>What you get</h2>
    <ul>
      <li>
        <strong>Build-time indexing</strong> of any markdown or MDX — content collections,
        standalone pages, anything on disk — into a D1 full-text index.
      </li>
      <li>
        <strong>An injected API endpoint</strong> (<code>GET /api/search</code>) with bm25 +
        recency ranking, highlighted snippets, type filtering, input validation and edge caching.
      </li>
      <li>
        <strong>A query function</strong> (<code>searchIndex</code>) for server-rendered search
        pages that hit the D1 binding directly, with no HTTP round trip.
      </li>
      <li>
        <strong>Content-type agnostic</strong>: types are strings you choose, so one index can
        serve site-wide search, per-section search, and even several sites at once.
      </li>
    </ul>
    <p>
      Requires the <a href="https://docs.astro.build/en/guides/integrations-guide/cloudflare/"
        ><code>@astrojs/cloudflare</code></a
      > adapter. The rest of your site stays fully static — only the search endpoint runs
      server-side.
    </p>
  </section>

  <section class="landing-section flow">
    <h2>Guides</h2>
    <SectionCards section="guides" />
  </section>

  <section class="landing-section flow">
    <h2>Reference</h2>
    <SectionCards section="reference" />
  </section>
</Layout>

<style>
  .hero {
    padding-block: 2vw;
    max-width: 640px;
  }

  .hero-title {
    font-size: var(--step-5);
    font-weight: 800;
    line-height: var(--line-height-xs);
    letter-spacing: -0.025em;
    margin-block: var(--space-sm) var(--space-md);
    color: var(--color-text);
  }

  .hero-subtitle {
    font-size: var(--step-1);
    line-height: var(--line-height-md);
    color: color-mix(in oklch, var(--color-text) 70%, transparent);
    max-width: 50ch;
  }

  .hero-actions {
    display: flex;
    gap: var(--space-xs);
    margin-block-start: var(--space-lg);
  }

  .hero-note {
    font-size: var(--step--1);
    color: color-mix(in oklch, var(--color-text) 65%, transparent);
    margin-block-start: var(--space-sm);
  }

  .landing-section {
    padding-block: var(--space-lg);
    border-top: 1px solid var(--color-border);
  }
</style>
