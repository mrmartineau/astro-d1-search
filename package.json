{
  "name": "astro-d1-search",
  "version": "0.0.0",
  "description": "Astro integration for site search backed by Cloudflare D1 (SQLite FTS5): build-time indexing, an injected search API endpoint, bm25 + recency ranking",
  "keywords": [
    "astro",
    "astro-integration",
    "cloudflare",
    "cloudflare-d1",
    "d1",
    "fts5",
    "full-text-search",
    "search",
    "sqlite"
  ],
  "homepage": "https://github.com/mrmartineau/astro-d1-search",
  "bugs": {
    "url": "https://github.com/mrmartineau/astro-d1-search/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Zander Martineau",
    "email": "zander@zander.wtf",
    "url": "https://zander.wtf"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mrmartineau/astro-d1-search.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./core": {
      "types": "./dist/core.d.mts",
      "default": "./dist/core.mjs"
    },
    "./indexer": {
      "types": "./dist/indexer.d.mts",
      "default": "./dist/indexer.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "check": "vp check --fix",
    "dev": "tsdown --watch",
    "docs:build": "pnpm --filter docs build",
    "docs:dev": "pnpm --filter docs dev",
    "docs:deploy": "pnpm --filter docs deploy",
    "prepare": "vp config",
    "release": "semantic-release",
    "test": "bun test"
  },
  "dependencies": {
    "@11ty/gray-matter": "^2.1.0"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^11.0.0",
    "@types/bun": "^1.3.10",
    "@types/node": "^25.4.0",
    "astro": "^7.0.6",
    "semantic-release": "^25.0.3",
    "tsdown": "^0.21.2",
    "typescript": "^5.9.3",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "astro": "^5.0.0 || ^6.0.0 || ^7.0.0"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "packageManager": "pnpm@11.10.0"
}
